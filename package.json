  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "eslint": "^10.9.1",
    "eslint-plugin-n": "^18.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0"
  }
