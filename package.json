{
  "name": "@safricloud/cl-workflow",
  "version": "0.6.0",
  "private": false,
  "description": "The contribution kit: a Claude Code process, its hooks and its installer.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Safricloud/cl-workflow.git"
  },
  "type": "module",
